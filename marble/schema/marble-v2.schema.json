{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edenrefinery.com/schema/marble-v2.schema.json",
  "title": "EDEN Marble v2",
  "type": "object",
  "required": ["schema","marble_id","kind","subject","parents","actor","policy","input","output","resources","quality","evidence","truth","provenance","timestamp"],
  "properties": {
    "schema": {"const": "eden.marble.v2"},
    "marble_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kind": {"enum": ["OBSERVATION","DECISION","EXECUTION","ASSERTION","VERIFICATION","ACCOUNTING","REFUTATION"]},
    "subject": {"type": "object"},
    "parents": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "uniqueItems": true},
    "actor": {"type": "object"},
    "policy": {
      "type": "object",
      "required": ["policy_id","policy_hash"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "policy_hash": {"type": "string", "minLength": 1}
      }
    },
    "input": {"type": "object"},
    "output": {"type": "object"},
    "resources": {"type": "object"},
    "quality": {"type": "object"},
    "evidence": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": {"enum": ["IMPLEMENTED","MEASURED","SIMULATED","MODELLED","PROPOSED","INDEPENDENTLY_VALIDATED"]},
        "instrumentation": {"type": "array", "items": {"type": "string"}},
        "independent_reproduction": {"type": ["string","object"]},
        "resource_provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["instrument","measurement_ref"],
            "properties": {
              "instrument": {"type": "string", "minLength": 1},
              "measurement_ref": {"type": "string", "minLength": 1},
              "unit": {"type": ["string","null"]},
              "method": {"type": ["string","null"]}
            }
          }
        }
      }
    },
    "truth": {
      "type": "object",
      "required": ["claims","not_claimed"],
      "properties": {
        "claims": {"type": "array", "items": {"type": "string"}},
        "not_claimed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "previous": {"type": ["string","null"]}
      }
    },
    "timestamp": {"type": "string"},
    "signature": {
      "type": ["object","string","null"],
      "description": "Mutable assurance envelope excluded from Marble event identity"
    },
    "assurance": {
      "type": ["object","null"],
      "description": "Optional appendable assurance data excluded from Marble event identity",
      "properties": {
        "timestamp_anchor": {
          "type": "object",
          "required": ["authority","observed_at","token"],
          "properties": {
            "authority": {"type": "string"},
            "observed_at": {"type": "string"},
            "external_ref": {"type": ["string","null"]},
            "token": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "attestation": {
          "type": "object",
          "required": ["subject","credential_hash","verifier","verified"],
          "properties": {
            "subject": {"type": "string"},
            "credential_hash": {"type": "string"},
            "verifier": {"type": "string"},
            "evidence_ref": {"type": ["string","null"]},
            "hardware_backed": {"type": "boolean"},
            "verified": {"type": "boolean"}
          }
        },
        "transparency": {"type": ["object","null"]},
        "external_reproductions": {"type": "array", "items": {"type": ["string","object"]}}
      }
    },
    "verification": {"type": ["object","null"]}
  },
  "additionalProperties": true
}
